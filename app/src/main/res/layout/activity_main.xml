<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bmo_turquoise_light">

    <com.spacexjr.bmo.face.BmoFaceView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/buttonKeyboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Conversar por texto"
            android:alpha="0.32"
            android:padding="9dp"
            android:src="@drawable/ic_keyboard"
            android:tint="#1A1A1A" />

        <ImageButton
            android:id="@+id/buttonSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Configurações"
            android:alpha="0.32"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            android:tint="#1A1A1A" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:alpha="0.55"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="#0B3026"
        android:textSize="13sp"
        android:text="Toque no rosto para conversar" />

    <TextView
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="70dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:background="@drawable/bg_bubble"
        android:elevation="6dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:maxLines="5"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:textColor="#F4FFFB"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>
