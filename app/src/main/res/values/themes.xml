<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BMO" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bmo_green</item>
        <item name="colorPrimaryVariant">@color/bmo_deep</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/bmo_turquoise</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/bmo_turquoise_light</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.BMO.Settings" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bmo_green</item>
        <item name="colorPrimaryVariant">@color/bmo_deep</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/bmo_green</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:statusBarColor">@color/bmo_deep</item>
        <item name="android:navigationBarColor">@color/settings_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
