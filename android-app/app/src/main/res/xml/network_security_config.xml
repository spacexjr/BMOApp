<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      A API do BMO é HTTP local, sem TLS, para funcionar offline na rede
      doméstica. O app exige token e não deve ser exposto à internet.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
